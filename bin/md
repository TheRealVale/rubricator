#!/usr/bin/env bash
# md — render a markdown file into a beautiful dark-mode page and open it.
# Assets: <prefix>/share/{template.html,vendor/}   Output: ~/.cache/rubricator/
set -euo pipefail

# resolve our own path (following symlinks) so rubricator runs straight from a
# checkout as well as from an install
_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_self" ]; do
  _d="$(cd -P "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  case "$_self" in /*) ;; *) _self="$_d/$_self" ;; esac
done
_BIN="$(cd -P "$(dirname "$_self")" && pwd)"

if [ -n "${RUBRICATOR_HOME:-}" ]; then
  SHARE="$RUBRICATOR_HOME"
elif [ -f "$_BIN/../share/template.html" ]; then
  SHARE="$(cd "$_BIN/.." && pwd)/share"                    # running from a checkout
elif [ -f "$_BIN/../share/rubricator/template.html" ]; then
  SHARE="$(cd "$_BIN/../share/rubricator" && pwd)"           # installed under a prefix
else
  SHARE="$HOME/.local/share/rubricator"
fi
CACHE="${RUBRICATOR_CACHE:-$HOME/.cache/rubricator}"
TPL="$SHARE/template.html"
VERSION="2.0.0"

usage() {
  cat <<'HELPTXT'
rubricator — read markdown, mark it up, send the notes to your AI.

USAGE
  md [options] [file|directory]

  The argument decides what opens:
    md                  the workspace for this directory, README already open
    md docs/plan.md     the reader, on that file
    md docs/            the workspace, scoped to that directory
    md -                the reader, on markdown from stdin

  Set RUBRICATOR_BARE=readme to make a bare "md" open README.md directly,
  the way it behaved before 2.0.

OPTIONS
  -b, --browser     open in your default browser tab (instead of a Chrome app window)
  -t, --tab         same as --browser
  -o, --out FILE    write the standalone .html to FILE and don't open anything
  -p, --print       print the generated HTML to stdout
  -n, --no-open     generate only; print the cache path
      --light       start in light mode (default is dark)
  -h, --help        show this help
  -v, --version     show version
      --vendor      re-download the render libraries and exit

WORKSPACE
  -w, --workspace [DIR]   the same workspace, named explicitly — safe to script
                          against, whatever the bare default becomes
      --sessions          also index your own Claude Code history, so a topic resolves
                          to the sessions that discussed it and the files they changed.
                          Local only — cannot be combined with --out.
      --static            skip the local server: build one self-contained page instead.
                          You lose reindexing and notes on disk; you gain a file you
                          can move. -o and -n always imply this.

REVIEW
      --review FILE opens the review window and waits; prints your feedback to
                    stdout, so it composes:  claude "$(md --review plan.md)"
      --hook plan   for a Claude Code PreToolUse/ExitPlanMode hook: finds the plan
                    file, opens the review window, blocks, and returns the decision

EXAMPLES
  md                       # the workspace for this directory
  md --sessions            # …and correlate it with your Claude Code history
  md README.md
  md ~/Repositories/other  # the workspace for another repo
  git show HEAD:NOTES.md | md -
  md -o /tmp/spec.html docs/spec.md    # self-contained, shareable HTML
HELPTXT
}

ensure_vendor() {
  local manifest="$SHARE/vendor.txt" missing=0 f url sha got
  [ -f "$manifest" ] || die "vendor manifest missing at $manifest"
  mkdir -p "$SHARE/vendor"
  while IFS="$(printf '\t')" read -r f url sha; do
    case "$f" in \#*|"") continue ;; esac
    if [ "${VENDOR_FORCE:-0}" = 1 ] || [ ! -s "$SHARE/vendor/$f" ]; then
      [ "$missing" = 0 ] && printf 'rubricator: fetching render libraries (one time)…\n' >&2
      missing=1
      command -v curl >/dev/null || die "curl is required to fetch the render libraries"
      curl -fsSL --retry 2 -o "$SHARE/vendor/$f.part" "$url" \
        || die "could not download $f from $url"
      if command -v shasum >/dev/null; then
        got="$(shasum -a 256 "$SHARE/vendor/$f.part" | cut -d" " -f1)"
        if [ -n "$sha" ] && [ "$got" != "$sha" ]; then
          rm -f "$SHARE/vendor/$f.part"
          die "checksum mismatch for $f (expected $sha, got $got)"
        fi
      fi
      mv "$SHARE/vendor/$f.part" "$SHARE/vendor/$f"
      printf '  %s\n' "$f" >&2
    fi
  done < "$manifest"
  [ "$missing" = 1 ] && printf 'rubricator: ready.\n' >&2
  return 0
}

die() { printf 'md: %s\n' "$1" >&2; exit 1; }

urlenc() {
  local s="$1" out="" c
  while [ -n "$s" ]; do
    c="${s%"${s#?}"}"; s="${s#?}"
    case "$c" in
      [A-Za-z0-9._~/-]) out="$out$c" ;;
      *) out="$out$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

# ── workspace: index a directory instead of rendering one file ───────────────
ws_run() {
  local dir="$1" out="$2" doopen="$3" sessions="$4" opendoc="$5"
  local PY abs file url
  PY="$(command -v python3 2>/dev/null || true)"; [ -x "$PY" ] || PY=/usr/bin/python3
  [ -x "$PY" ] || die "python3 is required for the workspace (try: md README.md)"
  [ -d "$dir" ] || die "not a directory: $dir"
  if [ -n "$out" ] && [ -n "$sessions" ]; then
    die "refusing --out with --sessions: your history stays on this machine"
  fi
  ensure_vendor
  mkdir -p "$CACHE"
  abs="$(cd "$dir" && pwd)"

  # Two tiers. Live is a small local server: the page fetches documents as it
  # needs them, can reindex without regenerating, and keeps notes in the repo.
  # Static is one self-contained file — no server, shareable, and what you get
  # whenever the answer has to be a file (-o) or a path (-n).
  if [ "$doopen" = 1 ] && [ -z "$out" ] && [ "${WS_STATIC:-0}" != 1 ]; then
    local urlfile
    urlfile="$(mktemp "$CACHE/.serve.XXXXXX")"
    RUBRICATOR_HOME="$SHARE" RUBRICATOR_OPEN="$opendoc" \
      nohup "$PY" "$SHARE/workspace.py" "$abs" $sessions --serve >"$urlfile" 2>/dev/null &
    local i=0 url=""
    while [ $i -lt 100 ]; do
      url="$(head -1 "$urlfile" 2>/dev/null || true)"
      case "$url" in http://127.0.0.1:*) break ;; esac
      url=""; i=$((i+1))
      command -v perl >/dev/null && perl -e 'select(undef,undef,undef,0.05)' 2>/dev/null || true
    done
    rm -f "$urlfile"
    if [ -n "$url" ]; then
      if [ -d "/Applications/Google Chrome.app" ]; then
        open -na "/Applications/Google Chrome.app" --args --app="$url" --window-size=1320,980 >/dev/null 2>&1 || open "$url"
      else open "$url"; fi
      return 0
    fi
    printf 'rubricator: could not start the local server; falling back to a static page\n' >&2
  fi

  file="${out:-$CACHE/workspace-$(printf '%s' "$abs" | shasum -a 1 | cut -c1-10).html}"
  RUBRICATOR_HOME="$SHARE" RUBRICATOR_OUT="$file" RUBRICATOR_OPEN="$opendoc" \
    "$PY" "$SHARE/workspace.py" "$abs" $sessions >/dev/null || exit 1
  if [ "$doopen" = 1 ] && [ -z "$out" ]; then
    url="file://$(urlenc "$file")"
    if [ -d "/Applications/Google Chrome.app" ]; then
      open -na "/Applications/Google Chrome.app" --args --app="$url" --window-size=1280,960 >/dev/null 2>&1 || open "$url"
    else open "$url"; fi
  else
    printf '%s\n' "$file"
  fi
}

# review modes hand off to the python runner (they block on a browser round-trip)
case "${1:-}" in
  --workspace|-w)
    # the explicit door into the workspace; the bare "md" below uses the same runner
    shift
    WS_DIR="."; WS_SESSIONS=""; WS_OUT=""; WS_OPEN=1
    while [ $# -gt 0 ]; do
      case "$1" in
        --sessions)   WS_SESSIONS="--sessions" ;;
        --static)     WS_STATIC=1 ;;
        -o|--out)     shift; WS_OUT="${1:?--out needs a path}" ;;
        -n|--no-open) WS_OPEN=0 ;;
        -*)           die "unknown workspace option: $1" ;;
        *)            WS_DIR="$1" ;;
      esac
      shift
    done
    ws_run "$WS_DIR" "$WS_OUT" "$WS_OPEN" "$WS_SESSIONS" ""
    exit 0 ;;
  --hook|--review)
    # hooks do not source your shell profile, so PATH may be bare
    PY="$(command -v python3 2>/dev/null || true)"
    [ -x "$PY" ] || PY=/usr/bin/python3
    MODE="$1"; shift
    if [ ! -x "$PY" ]; then
      # never break the caller: emit no decision and leave the normal flow alone
      [ "$MODE" = "--hook" ] && printf '%s' '{"systemMessage":"md: python3 not found - review skipped"}'
      exit 0
    fi
    if [ "$MODE" = "--hook" ]; then
      # exit code 2 would BLOCK the tool call in Claude Code, so this path must
      # never propagate a failure: no runner, or a crashing one, just means no review
      if [ ! -f "$SHARE/hook.py" ]; then
        printf '%s' '{"systemMessage":"md: review runner missing - skipped"}'
        exit 0
      fi
      "$PY" "$SHARE/hook.py" "${1:-plan}" || true
      exit 0
    fi
    [ -n "${1:-}" ] || die "--review needs a file"
    exec "$PY" "$SHARE/hook.py" manual "$1" ;;
esac

OPEN_MODE="app"; OUT=""; THEME="dark"; TO_STDOUT=0
FILE=""; SESSIONS=""

while [ $# -gt 0 ]; do
  case "$1" in
    -b|--browser|-t|--tab) OPEN_MODE="browser" ;;
    -n|--no-open)          OPEN_MODE="none" ;;
    -p|--print)            TO_STDOUT=1; OPEN_MODE="none" ;;
    -o|--out)              shift; [ $# -gt 0 ] || die "--out needs a path"; OUT="$1"; OPEN_MODE="none" ;;
    --light)               THEME="light" ;;
    --sessions)            SESSIONS="--sessions" ;;
    --static)              WS_STATIC=1 ;;
    --vendor)              VENDOR_FORCE=1 ;;
    -h|--help)             usage; exit 0 ;;
    -v|--version)          echo "md $VERSION"; exit 0 ;;
    -)                     FILE="-" ;;
    --)                    shift; FILE="${1:-}"; break ;;
    -*)                    die "unknown option: $1 (try md --help)" ;;
    *)                     FILE="$1" ;;
  esac
  shift
done

[ -f "$TPL" ] || die "template missing at $TPL (is rubricator installed?)"

# ── which door did the argument ask for? ─────────────────────────────────────
if [ "$OPEN_MODE" = "none" ]; then WS_OPEN=0; else WS_OPEN=1; fi
if [ -n "${FILE:-}" ] && [ "$FILE" != "-" ] && [ -d "$FILE" ]; then
  ws_run "$FILE" "$OUT" "$WS_OPEN" "$SESSIONS" ""
  exit 0
fi
if [ -z "${FILE:-}" ] && [ "${VENDOR_FORCE:-0}" != 1 ] && [ "${RUBRICATOR_BARE:-}" != "readme" ]; then
  # bare md: the workspace for here, with the README already open in the reader
  OPENDOC=""
  for cand in README.md readme.md README.markdown index.md; do
    [ -f "$cand" ] && { OPENDOC="$cand"; break; }
  done
  ws_run "." "$OUT" "$WS_OPEN" "$SESSIONS" "$OPENDOC"
  exit 0
fi
[ -z "$SESSIONS" ] || die "--sessions applies to the workspace, not to a single file"

ensure_vendor
if [ "${VENDOR_FORCE:-0}" = 1 ] && [ -z "${FILE:-}" ]; then exit 0; fi

# ── resolve input ────────────────────────────────────────────────────────────
mkdir -p "$CACHE"
TMP="$(mktemp -d "$CACHE/.tmp.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

if [ "${FILE:-}" = "-" ]; then
  SRC="$TMP/stdin.md"; cat > "$SRC"
  NAME="stdin"; DIR="$(pwd)"; BASEDIR="$(pwd)"; KEY="stdin-$(pwd)"
  ABS=""; REL="stdin"
else
  if [ -z "${FILE:-}" ]; then
    for cand in README.md readme.md README.markdown index.md; do
      [ -f "$cand" ] && { FILE="$cand"; break; }
    done
    [ -n "${FILE:-}" ] || die "no file given and no README.md here (try md --help)"
  fi
  [ -e "$FILE" ] || die "no such file: $FILE"
  [ -d "$FILE" ] && die "$FILE is a directory"
  [ -r "$FILE" ] || die "cannot read: $FILE"
  SRC="$FILE"
  BASEDIR="$(cd "$(dirname "$FILE")" && pwd)"
  NAME="$(basename "$FILE")"
  DIR="$BASEDIR"
  KEY="$BASEDIR/$NAME"
  ABS="$BASEDIR/$NAME"; REL="$FILE"
fi

# collapse $HOME to ~ for the header
DISPDIR="${DIR/#$HOME/~}"

# ── metadata ─────────────────────────────────────────────────────────────────
WORDS="$(wc -w < "$SRC" | tr -d ' ')"
if [ -f "$SRC" ]; then MTIME="$(date -r "$SRC" '+%b %e, %H:%M' | tr -s ' ')"; else MTIME=""; fi

# ── output path: stable per source file ──────────────────────────────────────
HASH="$(printf '%s' "$KEY" | shasum -a 1 | cut -c1-10)"
SLUG="$(printf '%s' "${NAME%.*}" | tr -c 'A-Za-z0-9._-' '-' | cut -c1-40)"
HTML="$CACHE/$SLUG-$HASH.html"

# ── url-encode ─────────────────────────────────────────────────────────────
BASE="file://$(urlenc "$BASEDIR")/"

# ── json/html escaping ───────────────────────────────────────────────────────
jesc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
hesc() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

HOOKJSON="${RUBRICATOR_HOOK:-null}"
META="{\"hook\":$HOOKJSON,\"name\":\"$(jesc "$NAME")\",\"path\":\"$(jesc "$ABS")\",\"rel\":\"$(jesc "$REL")\",\"base\":\"$(jesc "$BASE")\",\"dir\":\"$(jesc "$DISPDIR")\",\"words\":$WORDS,\"mtime\":\"$(jesc "$MTIME")\"}"

# ── payload ──────────────────────────────────────────────────────────────────
base64 < "$SRC" > "$TMP/payload.b64"

WANT_MERMAID=0
grep -qE '^[[:space:]]*(```|~~~)[[:space:]]*mermaid' "$SRC" && WANT_MERMAID=1

# ── assemble ─────────────────────────────────────────────────────────────────
awk -v vdir="$SHARE" -v payload="$TMP/payload.b64" -v title="$(hesc "$NAME")" \
    -v base="$BASE" -v meta="$META" -v theme="$THEME" -v mermaid="$WANT_MERMAID" '
function emit(p,   line) { while ((getline line < p) > 0) print line; close(p) }
function rep(s, tok, val,   i, out) {
  out = ""
  while ((i = index(s, tok)) > 0) { out = out substr(s, 1, i-1) val; s = substr(s, i + length(tok)) }
  return out s
}
{
  line = $0
  if (line ~ /^<!--@include /) {
    f = line; sub(/^<!--@include /, "", f); sub(/-->[[:space:]]*$/, "", f)
    if (f !~ /^\//) f = vdir "/" f
    emit(f); next
  }
  if (line ~ /^<!--@payload-->/) { emit(payload); next }
  if (line ~ /^<!--@mermaid-->/) {
    if (mermaid == 1) { print "<script>"; emit(vdir "/vendor/mermaid.min.js"); print "</" "script>" }
    next
  }
  line = rep(line, "__TITLE__", title)
  line = rep(line, "__META__",  meta)
  if (line ~ /^<html /) line = rep(line, "data-theme=\"dark\"", "data-theme=\"" theme "\"")
  print line
}' "$TPL" > "$TMP/out.html"

if [ $TO_STDOUT -eq 1 ]; then cat "$TMP/out.html"; exit 0; fi
if [ -n "$OUT" ]; then cp "$TMP/out.html" "$OUT"; printf 'md: wrote %s\n' "$OUT"; exit 0; fi

mv "$TMP/out.html" "$HTML"

# prune renders older than a week
find "$CACHE" -maxdepth 1 -name '*.html' -mtime +7 -delete 2>/dev/null || true

# ── open ─────────────────────────────────────────────────────────────────────
FILEURL="file://$(urlenc "$HTML")"
CHROME="/Applications/Google Chrome.app"

case "$OPEN_MODE" in
  none)    printf '%s\n' "$HTML" ;;
  browser) open "$FILEURL" ;;
  app)
    if [ -d "$CHROME" ]; then
      open -na "$CHROME" --args --app="$FILEURL" --window-size=1120,900 >/dev/null 2>&1 \
        || open "$FILEURL"
    else
      open "$FILEURL"
    fi ;;
esac
